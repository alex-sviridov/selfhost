appName: paperless

image:
  repository: ghcr.io/paperless-ngx/paperless-ngx
  tag: 3.0.5

service:
  port: 8000

ingress:
  - path: /docs/api
    extraMatch: "HeaderRegexp(`User-Agent`, `QuickScan`)"
    middlewares: 
      - name: strip-auth-headers
        namespace: oauth2-proxy
  - path: /docs/ws
    middlewares: 
      - name: strip-auth-headers
        namespace: oauth2-proxy
  - path: /docs
    middlewares: 
      - name: strip-auth-headers
        namespace: oauth2-proxy
      - name: errors
        namespace: oauth2-proxy
      - name: auth
        namespace: oauth2-proxy 

env:
  - name: PAPERLESS_REDIS
    value: "redis://paperless-redis-svc:6379"

  - name: PAPERLESS_FORCE_SCRIPT_NAME
    value: "/docs"
  
  - name: PAPERLESS_URL
    value: "https://{{ requiredEnv "SERVICE_HOSTNAME" }}"
  - name: PAPERLESS_CSRF_TRUSTED_ORIGINS
    value: "https://{{ requiredEnv "SERVICE_HOSTNAME" }}"
  - name: PAPERLESS_CORS_ALLOWED_HOSTS
    value: "https://{{ requiredEnv "SERVICE_HOSTNAME" }}"
  - name: PAPERLESS_LOGOUT_REDIRECT_URL
    value: "https://{{ requiredEnv "SERVICE_HOSTNAME" }}/oauth2/sign_out"

  # Секреты берем из .env файла
  - name: PAPERLESS_SECRET_KEY
    value: "{{ requiredEnv "PAPERLESS_SECRET_KEY" }}"
  - name: PAPERLESS_ADMIN_PASSWORD
    value: "{{ requiredEnv "PAPERLESS_ADMIN_PASSWORD" }}"
  - name: PAPERLESS_ADMIN_USER
    value: "{{ requiredEnv "PAPERLESS_ADMIN_USER" }}"

  - name: PAPERLESS_PORT
    value: "8000"
  - name: PAPERLESS_USE_X_FORWARD_HOST
    value: "true"
  - name: PAPERLESS_ENABLE_COMPRESSION
    value: "false"
  - name: PAPERLESS_CONVERT_MEMORY_LIMIT
    value: "32"
  - name: PAPERLESS_CONSUMER_DISABLE
    value: "true"
  - name: PAPERLESS_TIME_ZONE
    value: "Europe/Luxembourg"
  - name: PAPERLESS_ENABLE_HTTP_REMOTE_USER
    value: "true"
  - name: PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME
    value: "HTTP_X_AUTH_REQUEST_USER"
  - name: PAPERLESS_DISABLE_REGULAR_LOGIN
    value: "true"
  - name: PAPERLESS_OCR_LANGUAGES
    value: "rus eng fra"
  - name: PAPERLESS_OCR_LANGUAGE
    value: "rus"
  
  - name: PAPERLESS_FILENAME_FORMAT
    value: "{created_year}/{correspondent}/{title}"

resources:
  requests:
    memory: "512Mi"
    cpu: "500m"
  limits:
    memory: "2Gi"
    cpu: "1"

storage:
  data:
    mountPath: /usr/src/paperless/data
    accessMode: ReadWriteOnce
    size: 500Mi
  media:
    mountPath: /usr/src/paperless/media
    accessMode: ReadWriteOnce
    size: 2Gi