#cloud-config
# Minimal bootstrap for Rocky Linux 10 (Ansible Ready)

hostname: ${node_name}
preserve_hostname: false
fqdn: ${node_name}

# Создаем пользователя admin с sudo без пароля
users:
  - name: admin
    groups: [wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

# remove password auth
ssh_pwauth: false

# restore se contexts and install tailscale
runcmd:
  - restorecon -R /home/admin/.ssh
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key=${tailscale_auth_key} --hostname=${node_name} --advertise-tags=tag:server 