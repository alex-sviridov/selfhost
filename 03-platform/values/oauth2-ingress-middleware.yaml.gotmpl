resources:
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: ingress
      namespace: oauth2-proxy
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: websecure
    spec:
      ingressClassName: traefik
      rules:
        - host: {{ requiredEnv "SERVICE_HOSTNAME" }}
          http:
            paths:
              - path: /oauth2
                pathType: Prefix
                backend:
                  service:
                    name: oauth2-proxy
                    port:
                      number: 80
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: auth
      namespace: oauth2-proxy
    spec:
      forwardAuth:
        address: "http://oauth2-proxy.oauth2-proxy.svc.cluster.local/oauth2/auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "X-Auth-Request-User"
          - "X-Auth-Request-Email"
          - "X-Auth-Request-Access-Token"
          - "Authorization"
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: errors
      namespace: oauth2-proxy
    spec:
      errors:
        status:
          - "401"
        service:
          name: oauth2-proxy
          port: 80
        query: "/oauth2/sign_in?rd={url}"