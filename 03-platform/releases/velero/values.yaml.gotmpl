image:
  repository: docker.io/velero/velero
  tag: v1.18.2
  pullPolicy: IfNotPresent

initContainers:
  - name: velero-plugin-for-aws
    image: velero/velero-plugin-for-aws:v1.14.1
    imagePullPolicy: IfNotPresent
    volumeMounts:
      - mountPath: /target
        name: plugins

credentials:
  useSecret: true
  existingSecret: velero-s3-credentials

configuration:
  backupStorageLocation:
    - name: default
      provider: aws
      bucket: {{ requiredEnv "VELERO_S3_BUCKET" }}
      default: true
      config:
        region: {{ requiredEnv "VELERO_S3_REGION" }}
        s3ForcePathStyle: "true"
        s3Url: {{ requiredEnv "VELERO_S3_ENDPOINT" }}

  uploaderType: kopia
  fsBackupTimeout: 4h
  defaultBackupTTL: 720h
  defaultVolumesToFsBackup: false   

snapshotsEnabled: false   
deployNodeAgent: true

nodeAgent:
  podSecurityContext:
    runAsUser: 0
  resources:
    requests:
      cpu: 250m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi
