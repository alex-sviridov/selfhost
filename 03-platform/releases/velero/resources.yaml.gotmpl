resources:
  - apiVersion: v1
    kind: Secret
    type: Opaque
    metadata:
      name: velero-s3-credentials
      namespace: velero
    stringData:
      cloud: |
        [default]
        aws_access_key_id={{ requiredEnv "VELERO_S3_ACCESS_KEY" }}
        aws_secret_access_key={{ requiredEnv "VELERO_S3_SECRET_KEY" }}