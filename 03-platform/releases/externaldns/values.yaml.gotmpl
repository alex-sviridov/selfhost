provider:
  name: cloudflare

env:
  - name: CF_API_TOKEN
    valueFrom:
      secretKeyRef:
        name: cloudflare-api-token
        key: apiToken

sources:
  - traefik-proxy        

domainFilters:
  - {{ requiredEnv "TF_VAR_dns_zone_name" }}


extraArgs:
  - --cloudflare-proxied

policy: sync             
registry: txt
txtOwnerId: selfhost-cluster   